# --- vendor firmware and anything derived from it ---------------------------
# This repository must never carry FIFINE's or any other vendor's firmware.
# Supply your own inputs; keep the outputs out of git.
*.MVA
*.mva
*.bin
*.dis
*.mp3
*.wav
*.exe
*.rar
*.zip
# Belt and braces: nothing above ignores *.gz today, so this negation is
# inert. It is here so that adding a *.gz rule later cannot silently drop
# the one binary this repository is meant to ship.
!decrypt/labels/*.labels.gz

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
